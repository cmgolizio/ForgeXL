# Local Data Workbench — example environment configuration
#
# Copy to .env.local for local overrides:
#
#     cp .env.example .env.local
#
# .env.local is git-ignored. Nothing here is a secret; the proof of concept
# runs entirely on the local machine and requires no credentials.

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
# Loaded automatically by Next.js from .env.local / .env.
# NEXT_PUBLIC_ variables are inlined into the browser bundle at build time.
# Base URL the browser uses to reach the FastAPI backend directly.
# If unset, the frontend falls back to http://127.0.0.1:8000.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
# Read from the process environment by backend/app/config.py, which holds the
# defaults below. The backend does not read this file, so override these by
# exporting them in the shell that starts the backend, e.g.
#
#     FORGEXL_BACKEND_PORT=8001 npm run dev
#
# Loopback only. Do not bind to 0.0.0.0 — the app is intentionally local-only.
# FORGEXL_BACKEND_HOST=127.0.0.1
# FORGEXL_BACKEND_PORT=8000

# Where Run directories (inputs, working files, exports, manifests) are stored.
# Defaults to <repository root>/data.
# FORGEXL_DATA_DIRECTORY=

# Maximum accepted size of a single uploaded file, in bytes. Default 250 MB.
# FORGEXL_MAX_UPLOAD_BYTES=262144000

# Comma-separated CORS allowlist. Never use a wildcard.
# FORGEXL_ALLOWED_FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000