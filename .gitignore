# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# Local Data Workbench — added in Phase 0 (docs/build-plan.md §0.5)
# ---------------------------------------------------------------

# env files
# The `.env*` rule above already ignores every env file, including
# `.env.example`. The build plan (§20 and Phase 1.7) requires `.env.example`
# to be committed as documentation, so it is explicitly un-ignored here.
!.env.example
.env.local

# local data
# Two different things live under this rule, and neither may ever be committed.
#
#   run artifacts       There are none. ForgeXL keeps uploads, results and
#                       exports in memory and writes nothing, so Phase 6I
#                       removed the `data/runs/` tree this rule used to
#                       protect. Kept so a directory reintroduced by accident
#                       is not committed.
#
#   data/library/       The persistent Data Library added in Phase 9: real
#                       company sales history, sample history and account
#                       ownership. It is deliberately ignored in full — this
#                       is business data, not source, and it belongs on the
#                       machine that produced it and nowhere else.
#
# See docs/architecture.md.
data/

# python backend
backend/.venv/
__pycache__/
.pytest_cache/