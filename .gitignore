# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# Local Data Workbench — added in Phase 0 (docs/build-plan.md §0.5)
# ---------------------------------------------------------------

# env files
# The `.env*` rule above already ignores every env file, including
# `.env.example`. The build plan (§20 and Phase 1.7) requires `.env.example`
# to be committed as documentation, so it is explicitly un-ignored here.
!.env.example
.env.local

# run artifacts (preserved uploads, internal working files, exports)
data/runs/*
!data/runs/.gitkeep

# python backend
backend/.venv/
__pycache__/
.pytest_cache/